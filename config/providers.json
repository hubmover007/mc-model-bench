{
  "version": 2,
  "environment": {
    "note": "所有渠道必须在同一台机器（同一 AWS 实例）上、同一时间段内顺序执行，保证网络、算力、环境一致；runner 会把本机环境信息写入结果文件作为证据。"
  },
  "shared_request_params": {
    "temperature": 0.0,
    "top_p": 1.0
  },
  "reasoning_max_tokens": 4096,
  "timeouts": {
    "connect_seconds": 10,
    "read_seconds": 180,
    "read_seconds_long_context": 600
  },
  "retries": 2,
  "score_weights": {
    "performance": 0.3,
    "compatibility": 0.3,
    "quality": 0.2,
    "long_context": 0.2
  },
  "channels": [
    {
      "id": "channel_a",
      "name": "渠道A",
      "base_url": "https://api.channel-a.example.com/v1",
      "api_key_env": "CHANNEL_A_API_KEY",
      "api_key": "",
      "supports": {"stream_usage": true},
      "notes": "示例：请替换为真实 base_url"
    },
    {
      "id": "channel_b",
      "name": "渠道B",
      "base_url": "https://api.channel-b.example.com/v1",
      "api_key_env": "CHANNEL_B_API_KEY",
      "api_key": "",
      "supports": {"stream_usage": true},
      "notes": "示例：请替换为真实 base_url"
    }
  ],
  "models": [
    {
      "id": "deepseek-v4-pro",
      "aliases": {"channel_a": "deepseek-v4-pro", "channel_b": "deepseek-v4-pro"},
      "reasoning": false,
      "context": 128000,
      "supports": {"temperature": true, "tools": true, "json_mode": true},
      "notes": ""
    },
    {
      "id": "glm5.2",
      "aliases": {"channel_a": "glm-5.2", "channel_b": "glm-5.2"},
      "reasoning": false,
      "context": 128000,
      "supports": {"temperature": true, "tools": true, "json_mode": true},
      "notes": ""
    },
    {
      "id": "kimi-k3",
      "aliases": {"channel_a": "kimi-k3", "channel_b": "kimi-k3"},
      "reasoning": true,
      "context": 128000,
      "supports": {"temperature": false, "tools": true, "json_mode": true},
      "notes": "推理模型：不支持 temperature，max_tokens 自动抬到 reasoning_max_tokens"
    }
  ]
}
