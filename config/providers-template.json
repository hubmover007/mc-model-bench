{
  "version": 2,
  "environment": {
    "note": "所有渠道必须在同一台机器上顺序执行，保证网络、算力、环境一致；runner 会把本机环境信息（hostname/OS/CPU/内存/环境标注）写入结果与报告。"
  },
  "shared_request_params": {
    "temperature": 0.0,
    "top_p": 1.0
  },
  "reasoning_max_tokens": 4096,
  "timeouts": {
    "connect_seconds": 10,
    "read_seconds": 180,
    "read_seconds_long_context": 600
  },
  "retries": 2,
  "score_weights": {
    "performance": 0.3,
    "compatibility": 0.3,
    "quality": 0.2,
    "long_context": 0.2
  },
  "channels": [
    {
      "id": "easyrouter",
      "name": "EasyRouter",
      "base_url": "https://easyrouter.io/v1",
      "api_key_env": "EASYROUTER_API_KEY",
      "api_key": "",
      "supports": {"stream_usage": true},
      "notes": ""
    },
    {
      "id": "mayi",
      "name": "Mayi",
      "base_url": "https://maas-api-ga.computrix.ai/v1",
      "api_key_env": "MAYI_API_KEY",
      "api_key": "",
      "supports": {"stream_usage": true},
      "notes": ""
    }
  ],
  "models": [
    {
      "id": "deepseek-v4-pro",
      "aliases": {"easyrouter": "deepseek-v4-pro", "mayi": "deepseek-v4-pro-0813"},
      "reasoning": false,
      "context": 128000,
      "supports": {"temperature": true, "tools": true, "json_mode": true},
      "notes": ""
    },
    {
      "id": "glm5.2",
      "aliases": {"easyrouter": "glm-5.2", "mayi": "glm-5.2"},
      "reasoning": false,
      "context": 128000,
      "supports": {"temperature": true, "tools": true, "json_mode": true},
      "notes": "模型实际调用名请按渠道核对"
    },
    {
      "id": "kimi-k3",
      "aliases": {"easyrouter": "kimi-k3", "mayi": "kimi-k3"},
      "reasoning": true,
      "context": 128000,
      "supports": {"temperature": false, "tools": true, "json_mode": true},
      "notes": "推理模型：不支持 temperature，max_tokens 自动抬到 reasoning_max_tokens"
    }
  ]
}
