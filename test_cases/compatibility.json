   "tool_choice": "auto", "max_tokens": 300, "stream": false},
  {"id": "cmp_tools_02", "name": "Function Calling-多工具", "compat_feature": "function_calling",
   "prompt": "帮我查一下东京现在几点，以及东京的天气。",
   "tools": [
